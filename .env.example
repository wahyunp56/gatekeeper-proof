# HMAC secret from the Agent Games dashboard ("Rotate Secret").
# REQUIRED before going live — without it, inbound HMAC verification is
# disabled and the dashboard preflight fails (it requires a signed response).
AGENT_GAMES_HMAC_SECRET=

# HMAC encoding: hex (default) or sha256= (switch if the platform rejects preflight).
AGENT_GAMES_HMAC_FORMAT=hex

# Gatekeeper taskId mapping: keccak (default), numeric, or hex.
# The envelope's task_id is a string (e.g. "gk_24_9d1"); the circuit needs a
# field element. Confirm against a practice task; switch if the platform
# rejects the proof.
GATEKEEPER_TASK_ID_MODE=keccak

# Kurier API key (free, self-serve at https://kurier.xyz) for on-chain proof
# finalization. OPTIONAL — the server always responds with the local proof.
# If unset, Kurier is skipped entirely.
KURIER_API_KEY=
